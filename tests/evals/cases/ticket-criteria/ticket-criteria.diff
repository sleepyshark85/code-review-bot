+"""Export invoices as CSV for the finance team."""
+
+import csv
+from collections.abc import Iterable
+from pathlib import Path
+
+from billing.invoice import Invoice
+
+HEADER = ["invoice_id", "customer", "subtotal", "total"]
+
+
+def export_csv(invoices: Iterable[Invoice], path: Path) -> None:
+    """Write one row per invoice, after a header row."""
+    with path.open("w", encoding="utf-8", newline="") as handle:
+        writer = csv.writer(handle)
+        writer.writerow(HEADER)
+        for invoice in invoices:
+            row = [invoice.invoice_id, invoice.customer, invoice.subtotal, invoice.total()]
+            writer.writerow(row)
