+"""Whether an order can still be refunded."""
+
+from datetime import date
+
+from billing.orders import Order
+
+REFUND_WINDOW_DAYS = 30
+
+
+def can_refund(order: Order, today: date) -> bool:
+    """True while the order is inside the refund window, its last day included."""
+    age_days = (today - order.placed_on).days
+    return age_days > REFUND_WINDOW_DAYS
