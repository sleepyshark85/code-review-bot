+"""Merchant payouts, net of the platform fee."""
+
+from decimal import Decimal
+
+from billing.fees import platform_fee
+
+
+def payout(gross: Decimal) -> Decimal:
+    """What the merchant receives: the gross amount less the platform fee."""
+    fee = platform_fee(gross)
+    return gross + fee
